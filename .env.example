# ==============================================================================
# MailOne 生产配置文件模板
# 安装脚本执行后会自动生成 /opt/mailone/.env，按需修改后运行 systemctl restart mailone 生效
# ==============================================================================

# 服务本地监听绑定
# 默认监听 127.0.0.1 安全回环地址，不直接向公网暴露明文端口，推荐配合 Caddy / Nginx 反向代理使用 HTTPS
HOST=127.0.0.1
PORT=11001
DEBUG=false

# 外部公网访问地址（非常重要）
# 配置反向代理域名后，务必修改为你实际的公网访问地址（包含协议与域名，末尾不带斜杠）
# 用于在 Telegram 推送中生成可点击的短期免密只读 Magic Link
# 示例: https://mail.yourdomain.com
BASE_URL=https://mail.yourdomain.com

# 系统安全密钥（留空时首次启动会自动在 data/.secret_key 生成高强度私钥，无需手动填写）
SECRET_KEY=

# Telegram Bot 实时推送配置
# 1. 找 @BotFather 申请 Bot 获取 Token
TELEGRAM_BOT_TOKEN=
# 2. 允许接收推送的个人 Chat ID（多个用英文逗号分隔，找 @userinfobot 获取你的数字 ID）
# 示例: 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# 3. Telegram API 地址（若服务器在大陆需要反代，可替换为你的反代 API 地址）
TELEGRAM_API_BASE=https://api.telegram.org

# IMAP 轮询兜底周期（秒）
POLL_INTERVAL_SECONDS=60

# Telegram 免密 Magic Link 有效期（分钟，默认 30 分钟）
MAGIC_LINK_EXPIRE_MINUTES=30
