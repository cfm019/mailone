# ==============================================================================
# MailOne .gitignore
# ==============================================================================

# 1. 敏感配置与密钥凭据
.env
.env.*
!.env.example
*.pem
*.key
.secret_key

# 2. 本地持久化数据、数据库与邮件归档
data/
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.eml

# 3. Python 虚拟环境
.venv/
venv/
ENV/
env/
*.env

# 4. Python 编译缓存与字节码
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 5. 操作系统临时文件
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# 6. 编辑器与 IDE 配置
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# 7. 运行日志与临时目录
*.log
logs/
temp/
tmp/
