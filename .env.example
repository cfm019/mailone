# ==============================================================================
# MailOne 配置文件模板
# 复制为 .env 并在生产环境中根据需要修改
# ==============================================================================

# 服务绑定
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 外部公网访问基础地址（务必修改为你实际的域名或公网IP，用于在 TG 消息中生成可点击的 Magic Link）
# 示例: https://mail.yourdomain.com 或 http://1.2.3.4:8000
BASE_URL=http://localhost:8000

# 系统安全密钥（留空时系统会在首次启动时在 data/.secret_key 自动生成高强度密钥）
SECRET_KEY=

# Telegram Bot 推送配置
# 1. 找 @BotFather 申请 Bot 并获取 Token
TELEGRAM_BOT_TOKEN=
# 2. 允许接收推送的 Chat ID（多个用英文逗号分隔，找 @userinfobot 或 @getidsbot 获取你的数字 ID）
# 示例: 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# 3. Telegram API 地址（若服务器在大陆地区需要反向代理，可替换为你的反代地址）
TELEGRAM_API_BASE=https://api.telegram.org

# IMAP 轮询兜底周期（秒）
POLL_INTERVAL_SECONDS=60

# Telegram 免密 Magic Link 有效期（分钟，默认 30 分钟）
MAGIC_LINK_EXPIRE_MINUTES=30
